{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-timeline",
    "allow-marks",
    "allow-occurrence",
    "allow-live-start",
    "allow-live-stop",
    "allow-agent-status",
    "allow-start-agent",
    "allow-set-paused",
    "allow-set-sensitive",
    "allow-set-autostart",
    "allow-set-settings",
    "allow-settings"
  ]
}
